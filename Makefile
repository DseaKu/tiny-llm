# Wraps cargo/espflash so the ESP Xtensa toolchain is on PATH without
# touching your shell config. The env file is generated by `espup install`.
ESP_EXPORT ?= $(HOME)/export-esp.sh
ESP_ENV    := . $(ESP_EXPORT) &&

BIN     := project-blink
TARGET  := xtensa-esp32s3-none-elf
CHIP    := esp32s3

.DEFAULT_GOAL := build
.PHONY: build release run run-release flash monitor clippy clean check-env

check-env:
	@test -f $(ESP_EXPORT) || { echo "Missing $(ESP_EXPORT) - run 'espup install' first."; exit 1; }

build: check-env ## Debug build
	$(ESP_ENV) cargo build

release: check-env ## Release build
	$(ESP_ENV) cargo build --release

run: check-env ## Build, flash and open the serial monitor (debug)
	$(ESP_ENV) cargo run

run-release: check-env ## Build, flash and open the serial monitor (release)
	$(ESP_ENV) cargo run --release

flash: build ## Build and flash without opening the monitor
	espflash flash --chip $(CHIP) target/$(TARGET)/debug/$(BIN)

monitor: ## Open the serial monitor only
	espflash monitor --chip $(CHIP)

clippy: check-env
	$(ESP_ENV) cargo clippy

clean:
	cargo clean
